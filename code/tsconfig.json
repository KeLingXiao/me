{
  "include": ["javascript/**/*.ts", "nodejs/**/*.ts", "nodejs/**/*.mts"],
  "exclude": ["node_modules", "dist", "nodejs/fanyi"],
  "compilerOptions": {
    "noEmit": true,
    "outDir": "dist",
    "types": ["node"],
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    // 生产 sourcemap
    "sourceMap": true,
    "allowImportingTsExtensions": true,
  },
}
